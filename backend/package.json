{
  "name": "playspace-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "lint": "find src test -name '*.js' -print0 | xargs -0 -n1 node --check",
    "migrate": "node src/db/runMigrations.js",
    "test": "node --test test/**/*.test.js",
    "job:generate-slots": "node -e \"import('./src/jobs/generateSlots.js').then((m) => m.generateSlotsForNextSevenDays())\"",
    "job:cleanup-bookings": "node -e \"import('./src/jobs/cleanupExpiredBookings.js').then((m) => m.cleanupExpiredPendingBookings())\""
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.0",
    "zod": "^3.23.8"
  }
}
